# 默认响应头
# 注意：同一个响应头被多条规则命中时，Cloudflare Pages 会用逗号把值拼接起来，
# 所以 Cache-Control 只写在具体规则里，HTML 沿用平台默认的 public, max-age=0, must-revalidate
/*
  Permissions-Policy: browsing-topics=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; media-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# Astro 打包产物（自带内容 hash）- 长期不可变缓存
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 截图资源允许跨域引用（缓存由下方扩展名规则控制）
/screenshots/*
  Access-Control-Allow-Origin: *

# 图片文件 - 中期缓存
/*.png
  Cache-Control: public, max-age=604800, must-revalidate

/*.jpg
  Cache-Control: public, max-age=604800, must-revalidate

/*.jpeg
  Cache-Control: public, max-age=604800, must-revalidate

/*.webp
  Cache-Control: public, max-age=604800, must-revalidate

/*.gif
  Cache-Control: public, max-age=604800, must-revalidate

/*.svg
  Cache-Control: public, max-age=604800, must-revalidate

# 视频文件 - 长期缓存
/*.mp4
  Cache-Control: public, max-age=2592000, must-revalidate
  Accept-Ranges: bytes

/*.webm
  Cache-Control: public, max-age=2592000, must-revalidate
  Accept-Ranges: bytes

/*.mov
  Cache-Control: public, max-age=2592000, must-revalidate
  Accept-Ranges: bytes

# 字体文件 - 长期缓存
/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Sitemap 短期缓存
/sitemap*.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=604800
