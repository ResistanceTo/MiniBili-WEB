---
import Layout from "@layouts/Layout.astro";
import { FiArrowLeft } from "react-icons/fi";
---

<Layout title="页面未找到 - MiniBili" description="抱歉，你访问的页面不存在" showFooter={false} noindex>
  <main class="flex min-h-screen items-center justify-center px-4">
    <div class="glass max-w-md rounded-4xl px-8 py-12 text-center">
      <p class="text-8xl font-bold tracking-tight text-ink/90">404</p>
      <h1 class="mt-6 text-xl font-semibold text-ink">页面不存在</h1>
      <p class="mt-3 text-sm leading-relaxed text-ink-muted">你访问的页面可能已被移动、删除，或链接地址有误。</p>
      <p class="mt-1 text-xs text-ink-subtle" lang="en">This page could not be found.</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="inline-flex items-center gap-2 rounded-2xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700">
          <FiArrowLeft className="h-4 w-4" />
          返回首页
        </a>
        <a href="/changelog/" class="glass inline-flex items-center rounded-2xl px-5 py-3 text-sm font-semibold text-ink transition-colors hover:text-brand-ink">
          更新日志
        </a>
      </div>
    </div>
  </main>
</Layout>
