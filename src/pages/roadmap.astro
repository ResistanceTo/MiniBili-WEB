---
import BackToTop from "@components/ui/BackToTop.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import RoadmapTree from "@components/sections/RoadmapTree.astro";
import BreadcrumbSchema from "@components/seo/BreadcrumbSchema.astro";
import Layout from "@layouts/Layout.astro";

const siteBase = Astro.site?.href ?? 'https://minibili.zhaohe.org/';
const breadcrumbItems = [
  { name: "首页", url: siteBase },
  { name: "开发路线图", url: `${siteBase}roadmap/` }
];
---

<Layout
  title="开发路线图 - MiniBili B站第三方客户端"
  description="MiniBili（B站第三方客户端）的开发路线图：查看已完成、开发中和计划中的功能，包括播放、弹幕、下载、评论、动态等模块。"
>
  <BreadcrumbSchema items={breadcrumbItems} slot="head" />
  <main class="mx-auto max-w-3xl px-4 pb-16 pt-24 sm:px-6 sm:pt-28">
    <Breadcrumbs items={[{ label: "开发路线图" }]} />
    <RoadmapTree />
  </main>
  <BackToTop />
</Layout>
