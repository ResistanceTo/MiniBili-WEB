---
import BackToTop from "@components/ui/BackToTop.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import ChangelogList from "@components/sections/ChangelogList.astro";
import BreadcrumbSchema from "@components/seo/BreadcrumbSchema.astro";
import Layout from "@layouts/Layout.astro";

const siteBase = Astro.site?.href ?? 'https://minibili.zhaohe.org/';
const breadcrumbItems = [
  { name: "首页", url: siteBase },
  { name: "更新日志", url: `${siteBase}changelog/` }
];
---

<Layout
  title="更新日志 - MiniBili B站第三方客户端"
  description="MiniBili（B站第三方客户端）的全部版本更新记录，包括 iOS、iPadOS、macOS 的新功能、体验优化和问题修复，支持 RSS 订阅。"
>
  <BreadcrumbSchema items={breadcrumbItems} slot="head" />
  <main class="mx-auto max-w-3xl px-4 pb-16 pt-24 sm:px-6 sm:pt-28">
    <Breadcrumbs items={[{ label: "更新日志" }]} />
    <ChangelogList />
  </main>
  <BackToTop />
</Layout>
