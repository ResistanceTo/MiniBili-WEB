---
import type { FeaturesProps } from "config";
import { featureHighlights } from "config/featureHighlights";
import { platformSummaryText } from "config/productFacts";

const { items } = Astro.props as FeaturesProps;
---

<section id="features" class="scroll-mt-28 py-12 sm:py-20">
  <div class="mb-10 text-center">
    <p class="mb-2 text-sm font-semibold tracking-[0.15em] text-brand-ink">为什么选择 MiniBili</p>
    <h2 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">纯粹且免费</h2>
    <p class="mx-auto mt-4 max-w-2xl text-balance text-sm leading-relaxed text-ink-muted">
      MiniBili 是一款免费、无广告、无跟踪器的 B站（哔哩哔哩）第三方客户端，支持 {platformSummaryText}，基于 SwiftUI 原生打造。
    </p>
  </div>

  <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
    {items.map(({ icon: Icon, title, description }) => (
      <div class="glass group rounded-4xl p-7 transition-all duration-300 hover:-translate-y-1">
        <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-brand/10 text-brand-ink transition-transform duration-300 group-hover:scale-110">
          <Icon className="h-7 w-7" />
        </div>
        <h3 class="mb-2 text-lg font-semibold text-ink">{title}</h3>
        <p class="text-sm leading-relaxed text-ink-muted">{description}</p>
      </div>
    ))}
  </div>

  <div class="mb-8 mt-16 text-center sm:mt-20" id="feature-list">
    <p class="mb-2 text-sm font-semibold tracking-[0.15em] text-brand-ink">功能一览</p>
    <h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">常用功能，原生体验</h2>
    <p class="mx-auto mt-3 max-w-xl text-balance text-sm leading-relaxed text-ink-muted">
      以下是目前可以使用的主要功能，开发进度见<a href="/roadmap/" class="font-medium text-brand-ink hover:underline">路线图</a>，逐版本变化见<a href="/changelog/" class="font-medium text-brand-ink hover:underline">更新日志</a>。
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {featureHighlights.map(({ icon: Icon, title, items: groupItems }) => (
      <div class="glass rounded-3xl p-6">
        <h3 class="mb-4 flex items-center gap-2.5 text-base font-semibold text-ink">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-brand/10 text-brand-ink">
            <Icon className="h-4 w-4" />
          </span>
          {title}
        </h3>
        <ul class="feature-items space-y-2 text-sm leading-relaxed text-ink-muted">
          {groupItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .feature-items li {
    position: relative;
    padding-left: 1.25rem;
  }

  /* 对勾 */
  .feature-items li::before {
    content: "";
    position: absolute;
    left: 0.15rem;
    top: 0.45em;
    width: 0.4rem;
    height: 0.7rem;
    border: solid rgb(var(--brand-ink));
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
</style>
