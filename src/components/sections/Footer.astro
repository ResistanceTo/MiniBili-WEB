---
import { productFacts } from "config/productFacts";
import { RiGithubFill, RiHomeSmileFill, RiTelegram2Fill } from "react-icons/ri";
import { type Lang, ui } from "../../i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "zh" } = Astro.props;
const t = ui[lang].footer;
const description = lang === "zh" ? productFacts.description : productFacts.descriptionEn;

const socialLinks = [
  { url: productFacts.telegramUrl, icon: RiTelegram2Fill, label: t.social.telegram },
  { url: "https://github.com/ResistanceTo/MiniBili-WEB", icon: RiGithubFill, label: t.social.github },
  { url: "https://zhaohe.org/zh-cn/", icon: RiHomeSmileFill, label: t.social.homepage },
];
---

<footer class="relative z-10 mt-8 px-4 pb-6 sm:px-6">
  <div class="glass mx-auto max-w-[1120px] rounded-4xl p-6 sm:p-8">
    <div class="flex flex-col gap-8">
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row">
        <div class="flex max-w-md flex-col gap-3">
          <div class="flex items-center gap-2.5">
            <img src="/favicon-512.png" alt="" class="h-7 w-7 rounded-lg shadow-sm" width="28" height="28" />
            <span class="text-lg font-semibold text-ink">MiniBili</span>
          </div>
          <p class="text-sm leading-relaxed text-ink-muted">{description}</p>
          <p class="text-xs leading-relaxed text-ink-subtle">{t.disclaimer}</p>
        </div>

        <div class="flex flex-col items-start gap-4 sm:items-end">
          <div class="flex items-center gap-2">
            {socialLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-9 w-9 items-center justify-center rounded-xl border border-hairline/10 bg-hairline/[0.04] text-ink-muted transition-colors hover:bg-hairline/[0.08] hover:text-ink"
                aria-label={link.label}
                title={link.label}
              >
                <link.icon className="h-4 w-4" />
              </a>
            ))}
          </div>
          <nav class="flex max-w-sm flex-wrap items-center gap-x-4 gap-y-2 sm:justify-end" aria-label={t.nav}>
            {t.links.map((link) => (
              <a
                href={link.href}
                hreflang={"hreflang" in link ? link.hreflang : undefined}
                class="text-sm text-ink-muted transition-colors hover:text-ink"
              >
                {link.label}
              </a>
            ))}
          </nav>
        </div>
      </div>

      <div class="border-t border-hairline/10 pt-5 text-center text-xs text-ink-subtle sm:text-left">
        &copy; {new Date().getFullYear()} MiniBili · Made with ❤️ by ResistanceTo
      </div>
    </div>
  </div>
</footer>
