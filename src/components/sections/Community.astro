---
import { productFacts } from "config/productFacts";
import { RiGithubFill, RiMailFill, RiTelegram2Fill } from "react-icons/ri";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang?: Lang;
}

interface CommunityLink {
  icon: typeof RiTelegram2Fill;
  title: string;
  description: string;
  url: string;
  primary?: boolean;
}

const { lang = "zh" } = Astro.props;
const isZh = lang === "zh";

const communityLinks: CommunityLink[] = [
  {
    icon: RiTelegram2Fill,
    title: isZh ? "Telegram 群组" : "Telegram group",
    description: isZh ? "获取最新动态和技术交流" : "News, beta openings and discussion",
    url: productFacts.telegramUrl,
    primary: true,
  },
  {
    icon: RiGithubFill,
    title: "GitHub Issues",
    description: isZh ? "报告问题、提出建议" : "Report bugs and request features",
    url: "https://github.com/ResistanceTo/MiniBili-WEB/issues",
  },
  {
    icon: RiMailFill,
    title: isZh ? "电子邮件" : "Email",
    description: isZh ? "发送邮件联系开发者" : "Contact the developer",
    url: "mailto:me@zhaohe.org",
  },
];
---
<section id="community" class="scroll-mt-28 py-12 sm:py-20">
  <div class="mb-10 text-center">
    <p class="mb-2 text-sm font-semibold tracking-[0.15em] text-brand-ink">{isZh ? "交流与支持" : "Community"}</p>
    <h2 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{isZh ? "社区与反馈" : "Get in touch"}</h2>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    {communityLinks.map((link) => (
      <a
        href={link.url}
        target={link.url.startsWith("http") ? "_blank" : undefined}
        rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined}
        class:list={[
          "group flex items-center gap-4 rounded-3xl p-5 transition-all duration-300 hover:-translate-y-1",
          link.primary ? "glass-strong ring-1 ring-brand/30" : "glass",
        ]}
      >
        <div class:list={[
          "flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-2xl transition-transform duration-300 group-hover:scale-110",
          link.primary ? "bg-brand/15 text-brand-ink" : "bg-hairline/[0.06] text-ink",
        ]}>
          <link.icon className="h-6 w-6" />
        </div>
        <div class="min-w-0 flex-1">
          <h3 class="truncate text-base font-semibold text-ink">{link.title}</h3>
          <p class="truncate text-sm text-ink-muted">{link.description}</p>
        </div>
      </a>
    ))}
  </div>
</section>
