---
import { changelog } from "config/changelog";
import { productFacts } from "config/productFacts";
import { type Lang, ui } from "../../i18n/ui";
import { getResponsiveImage } from "../../lib/images";

interface Props {
  lang?: Lang;
}

const { lang = "zh" } = Astro.props;
const t = ui[lang].hero;
const { platforms, sponsorship } = productFacts;
const latest = changelog[0];
const heroImage = await getResponsiveImage("/screenshots/iphone/home_new.webp");
const changelogHref = `/changelog/#${latest.build}`;

const menuItems = [
  { device: "iPhone", url: platforms.ios.downloadUrl, note: `${platforms.ios.name} ${platforms.ios.minimumVersion}` },
  { device: "iPad", url: platforms.ipados.downloadUrl, note: `${platforms.ipados.name} ${platforms.ipados.minimumVersion}` },
  { device: "Apple Watch", url: platforms.watchos.downloadUrl, note: `${platforms.watchos.name} ${platforms.watchos.minimumVersion} · ${t.watchNote}` },
  { device: "Mac", url: platforms.macos.downloadUrl, note: `${platforms.macos.name} ${platforms.macos.minimumVersion}` },
];
---

<section class="relative grid items-center gap-12 pt-6 md:pt-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-16 lg:gap-y-0">
  <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
    <div class="relative mb-7">
      <div class="absolute inset-0 -z-10 scale-150 rounded-full bg-brand/25 blur-3xl" aria-hidden="true"></div>
      <img
        src="/MiniBili.png"
        alt={lang === "zh" ? "MiniBili 应用图标" : "MiniBili app icon"}
        class="h-24 w-24 rounded-[22px] shadow-glass-lg sm:h-28 sm:w-28"
        width="112"
        height="112"
        decoding="async"
      />
    </div>

    <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-hairline/10 bg-hairline/[0.04] px-3 py-1.5 text-xs font-medium text-ink-muted">
      <span class="relative flex h-2 w-2" aria-hidden="true">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand opacity-60"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-brand"></span>
      </span>
      {t.pill}
    </div>

    <h1 class="max-w-3xl text-4xl font-bold leading-[1.1] tracking-tight text-ink sm:text-5xl lg:text-6xl">
      <span class="mb-3 block text-2xl font-semibold tracking-tight text-ink-muted sm:text-3xl">MiniBili</span>{t.slogan[0]}<span class="bg-gradient-to-r from-brand-600 to-brand-700 bg-clip-text text-transparent dark:from-brand-400 dark:to-brand-500">{t.slogan[1]}</span>{t.slogan[2]}
    </h1>

    <p class="mt-5 max-w-xl text-balance text-base leading-relaxed text-ink-muted sm:text-lg">{t.intro}</p>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-2 lg:justify-start">
      {t.badges.map((badge) => (
        <span class="rounded-full border border-hairline/10 bg-hairline/[0.03] px-3 py-1 text-xs font-medium text-ink-muted">{badge}</span>
      ))}
    </div>

    <div class="mt-8 flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row" data-download>
      <!-- 拆分按钮：左侧按设备一键下载，右侧展开全部平台 -->
      <div class="relative flex w-full rounded-2xl shadow-[0_8px_28px_-6px_rgba(251,114,153,0.65)] sm:w-auto">
        <a
          href={platforms.ios.downloadUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-1 items-center justify-center gap-2.5 rounded-l-2xl bg-brand-600 py-3.5 pl-6 pr-5 font-semibold text-white transition-colors hover:bg-brand-700 active:scale-[0.98]"
          data-download-primary
        >
          <img src="/TestFlight.png" alt="" class="h-6 w-6 rounded-md" width="24" height="24" />
          <span data-download-label>{t.download}</span>
        </a>
        <details class="group" data-download-menu>
          <summary
            class="flex h-full cursor-pointer list-none items-center rounded-r-2xl border-l border-white/30 bg-brand-600 px-3.5 text-white transition-colors hover:bg-brand-700 group-open:bg-brand-700"
            aria-label={t.chooseOther}
            title={t.chooseOther}
          >
            <svg class="h-5 w-5 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <div class="absolute left-0 top-full z-50 mt-2 w-full overflow-hidden rounded-2xl border border-hairline/10 bg-surface p-1.5 text-left shadow-glass-lg sm:w-80">
            <p class="px-4 pb-1 pt-2 text-xs font-medium text-ink-subtle">{t.chooseOther}</p>
            {menuItems.map((item) => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between gap-4 rounded-xl px-4 py-2.5 transition-colors hover:bg-hairline/[0.06]"
                data-device={item.device}
              >
                <span class="flex items-center gap-2 whitespace-nowrap text-sm font-medium text-ink">
                  {item.device}
                  <span class="hidden rounded-full bg-brand/10 px-1.5 py-px text-[10px] font-semibold text-brand-ink" data-current-badge>{t.currentDevice}</span>
                </span>
                <span class="text-right text-xs text-ink-subtle">{item.note}</span>
              </a>
            ))}
          </div>
        </details>
      </div>

      <a
        href={sponsorship.url}
        target="_blank"
        rel="noopener noreferrer"
        class="glass flex w-full items-center justify-center gap-2.5 rounded-2xl px-6 py-3.5 font-semibold text-ink transition-all hover:-translate-y-0.5 active:scale-[0.98] sm:w-auto"
      >
        <img src="/toubi.svg" alt="" class="h-6 w-6" width="24" height="24" />
        <span>{t.sponsor}</span>
      </a>
    </div>

    <p class="mt-4 max-w-xl text-balance text-xs leading-relaxed text-ink-subtle">
      {t.requirement} · <a href={t.fullHref} class="font-medium text-ink-muted underline-offset-2 hover:text-brand-ink hover:underline">{t.full}</a>
    </p>
    <p class="mt-3 hidden max-w-xl rounded-2xl border border-amber-500/30 bg-amber-500/10 px-4 py-2.5 text-xs leading-relaxed text-ink" data-download-unsupported>
      {t.unsupported}
    </p>

    <a href={changelogHref} class="mt-5 inline-flex items-center gap-1.5 text-xs font-medium text-ink-subtle transition-colors hover:text-brand-ink">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
      {t.latest(latest.build, latest.date)}
    </a>
  </div>

  <!-- 窄屏下紧接着就是截图轮播，所以只在宽屏显示；窄屏用 1px 占位源，避免下载 -->
  <div class="relative mx-auto hidden w-[300px] lg:block">
    <div class="absolute -inset-8 -z-10 rounded-full bg-gradient-to-br from-brand/30 via-transparent to-sky-400/25 blur-3xl" aria-hidden="true"></div>
    <picture>
      <source media="(max-width: 1023px)" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" />
      <img
        src={heroImage.src}
        srcset={heroImage.srcset}
        sizes="300px"
        width={heroImage.width}
        height={heroImage.height}
        alt={t.screenshotAlt}
        fetchpriority="high"
        decoding="async"
        class="h-auto w-full rounded-[2.25rem] shadow-glass-lg ring-1 ring-hairline/10"
      />
    </picture>
  </div>
</section>

<style>
  summary::-webkit-details-marker { display: none; }
</style>

<script is:inline define:vars={{ links: { ios: platforms.ios.downloadUrl, mac: platforms.macos.downloadUrl }, labels: { iPhone: t.downloadFor("iPhone"), iPad: t.downloadFor("iPad"), Mac: t.downloadFor("Mac") } }}>
  (function () {
    const root = document.querySelector("[data-download]");
    if (!root) return;

    const primary = root.querySelector("[data-download-primary]");
    const menu = root.querySelector("[data-download-menu]");
    const summary = menu.querySelector("summary");

    // iPadOS 默认以桌面版 Safari 的身份访问，需要用触控点数量区分 iPad 与 Mac
    const ua = navigator.userAgent;
    const touch = navigator.maxTouchPoints > 1;
    let device = null;
    if (/iPhone|iPod/.test(ua)) device = "iPhone";
    else if (/iPad/.test(ua) || (/Macintosh/.test(ua) && touch)) device = "iPad";
    else if (/Macintosh/.test(ua)) device = "Mac";

    if (device) {
      primary.href = device === "Mac" ? links.mac : links.ios;
      primary.querySelector("[data-download-label]").textContent = labels[device];
      menu.querySelector(`[data-device="${device}"] [data-current-badge]`)?.classList.remove("hidden");
    } else {
      // 识别不出设备时，主按钮直接展开平台菜单
      primary.addEventListener("click", (event) => {
        event.preventDefault();
        menu.open = true;
        menu.querySelector("[data-device]")?.focus();
      });
      if (/Android|Windows|Linux|CrOS/.test(ua)) {
        document.querySelector("[data-download-unsupported]")?.classList.remove("hidden");
      }
    }

    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target) && !primary.contains(event.target)) menu.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (menu.open && event.key === "Escape") {
        menu.open = false;
        summary.focus();
      }
    });
  })();
</script>
