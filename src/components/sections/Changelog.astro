---
import type { ChangelogProps } from "config";
import { FiClock, FiStar, FiTool, FiTrendingUp } from "react-icons/fi";
import { normalizeEntry, withAnchors } from "../../lib/changelog";

const { items } = Astro.props as ChangelogProps;
const recentVersions = withAnchors(items).slice(0, 3);

// 首页每个版本最多展示的条目数，完整内容在更新日志页
const MAX_ENTRIES = 4;

const groups = [
  { key: "feature" as const, icon: FiStar, color: "text-emerald-700 dark:text-emerald-400", dot: "bg-emerald-500", label: "新功能" },
  { key: "improvement" as const, icon: FiTrendingUp, color: "text-sky-700 dark:text-sky-400", dot: "bg-sky-500", label: "优化" },
  { key: "bugfix" as const, icon: FiTool, color: "text-amber-700 dark:text-amber-400", dot: "bg-amber-500", label: "修复" },
];

// 按 新功能 → 优化 → 修复 的顺序截取前几条
const pickEntries = (updates: (typeof recentVersions)[number]["updates"]) => {
  let remaining = MAX_ENTRIES;
  const picked = groups
    .map((group) => {
      const entries = (updates[group.key] ?? []).map((entry) => normalizeEntry(entry).text);
      const shown = entries.slice(0, Math.max(remaining, 0));
      remaining -= shown.length;
      return { ...group, entries: shown };
    })
    .filter((group) => group.entries.length > 0);
  const total = groups.reduce((sum, group) => sum + (updates[group.key]?.length ?? 0), 0);
  return { picked, hidden: total - picked.reduce((sum, group) => sum + group.entries.length, 0) };
};
---

<section id="changelog" class="scroll-mt-28 py-12 sm:py-20">
  <div class="mb-10 flex flex-col items-center gap-3 text-center sm:flex-row sm:items-end sm:justify-between sm:text-left">
    <div>
      <p class="mb-2 text-sm font-semibold tracking-[0.15em] text-brand-ink">持续进化</p>
      <h2 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">最新更新</h2>
    </div>
    <a href="/changelog/" class="glass inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-medium text-ink transition-all hover:-translate-y-0.5">
      查看全部更新
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    {recentVersions.map(({ anchor, version, build, date, title, updates, platforms }) => {
      const { picked, hidden } = pickEntries(updates);
      return (
        <article class="glass flex flex-col rounded-4xl p-6 transition-all duration-300 hover:-translate-y-1">
          <div class="mb-3 flex items-center justify-between gap-2">
            <h3 class="flex items-baseline gap-1.5">
              <a href={`/changelog/#${anchor}`} class="text-xl font-bold text-ink transition-colors hover:text-brand-ink">
                <span class="sr-only">Build </span>{build}
              </a>
              <span class="text-sm text-ink-subtle">{version}</span>
            </h3>
            <div class="flex gap-1">
              {platforms.map((platform) => (
                <span class="rounded-full bg-brand/10 px-2 py-0.5 text-[11px] font-semibold text-brand-ink">{platform}</span>
              ))}
            </div>
          </div>

          <div class="mb-4 flex items-center gap-1.5 text-xs text-ink-subtle">
            <FiClock className="h-3 w-3" />
            <time datetime={date}>{date}</time>
          </div>

          {title && (
            <div class="mb-4 rounded-2xl border border-brand/20 bg-brand/[0.06] p-3">
              <p class="text-xs font-medium leading-relaxed text-ink">{title}</p>
            </div>
          )}

          <div class="flex-1 space-y-3">
            {picked.map(({ icon: Icon, color, dot, label, entries }) => (
              <div>
                <div class="mb-1.5 flex items-center gap-1.5">
                  <Icon className={`h-3.5 w-3.5 ${color}`} />
                  <span class="text-xs font-semibold text-ink-muted">{label}</span>
                </div>
                <ul class="space-y-1">
                  {entries.map((text) => (
                    <li class="flex gap-1.5 text-sm leading-relaxed text-ink-muted">
                      <span class={`mt-2 h-1 w-1 flex-shrink-0 rounded-full ${dot}`} aria-hidden="true"></span>
                      <span>{text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          {hidden > 0 && (
            <a href={`/changelog/#${anchor}`} class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-ink hover:underline">
              还有 {hidden} 项更新
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          )}
        </article>
      );
    })}
  </div>
</section>
