---
import { changelog } from "config/changelog";
import { featureHighlights, featureHighlightsEn } from "config/featureHighlights";
import { productFacts } from "config/productFacts";
import { screenshots } from "config/screenshots";
import { htmlLang, type Lang } from "../../i18n/ui";

interface Props {
  includeApplication?: boolean;
  lang?: Lang;
  title: string;
  description?: string;
}

const {
  includeApplication = false,
  lang = "zh",
  title,
  description,
} = Astro.props;

const siteBase = Astro.site?.href.replace(/\/$/, "") ?? "https://minibili.zhaohe.org";
const siteUrl = `${siteBase}/`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = new URL(
  includeApplication ? "/screenshots/iphone/home_new.webp" : "/og_image.png",
  siteUrl,
).href;

const ids = {
  website: `${siteUrl}#website`,
  developer: `${siteUrl}#developer`,
  app: `${siteUrl}#app`,
  webpage: `${canonicalUrl}#webpage`,
};

const developer = {
  "@type": "Person",
  "@id": ids.developer,
  "name": "ResistanceTo",
  "url": "https://zhaohe.org/zh-cn/",
  "sameAs": ["https://github.com/ResistanceTo"],
};

const website = {
  "@type": "WebSite",
  "@id": ids.website,
  "url": siteUrl,
  "name": "MiniBili",
  "alternateName": ["MiniBili B站第三方客户端", "MiniBili 哔哩哔哩客户端"],
  "description": productFacts.description,
  "inLanguage": "zh-CN",
  "publisher": { "@id": ids.developer },
};

const webpage = {
  "@type": "WebPage",
  "@id": ids.webpage,
  "url": canonicalUrl,
  "name": title,
  "description": description,
  "inLanguage": htmlLang[lang],
  "isPartOf": { "@id": ids.website },
  "about": includeApplication ? { "@id": ids.app } : undefined,
  "primaryImageOfPage": {
    "@type": "ImageObject",
    "url": imageUrl,
  },
};

const isZh = lang === "zh";
const releasedPlatforms = Object.values(productFacts.platforms);
const latestRelease = changelog[0];
const screenshotUrls = (screenshots.iOS ?? [])
  .slice(0, 4)
  .map((item) => new URL(item.src, siteUrl).href);
const application = {
  "@type": "SoftwareApplication",
  "@id": ids.app,
  "name": "MiniBili",
  "url": siteUrl,
  "description": isZh ? productFacts.description : productFacts.descriptionEn,
  "inLanguage": ["zh-Hans", "zh-Hant", "en"],
  "applicationCategory": "EntertainmentApplication",
  "operatingSystem": releasedPlatforms.map(
    (platform) => `${platform.name} ${platform.minimumVersion}`,
  ),
  "isAccessibleForFree": true,
  "offers": {
    "@type": "Offer",
    "price": 0,
    "priceCurrency": "CNY",
  },
  "featureList": isZh
    ? [
        "完全免费",
        "无广告",
        "无跟踪器",
        "无服务器上传，App 数据仅保存在本地设备",
        "SwiftUI 原生打造",
        ...featureHighlights.flatMap((group) => group.items),
      ]
    : ["Free", "No ads", "No trackers", "Native SwiftUI app", ...featureHighlightsEn.flatMap((group) => group.items)],
  "softwareVersion": String(latestRelease.build),
  "dateModified": latestRelease.date,
  "releaseNotes": new URL("/changelog/", siteUrl).href,
  "screenshot": screenshotUrls,
  "author": { "@id": ids.developer },
  "publisher": { "@id": ids.developer },
  "downloadUrl": [...new Set(releasedPlatforms.map((platform) => platform.downloadUrl))],
};

const graph = includeApplication
  ? [website, webpage, application, developer]
  : [website, webpage, developer];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
